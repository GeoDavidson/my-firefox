{
  "manifest_version": 2,
  "name": "My New Tab",
  "version": "2.5",
  "description": "Replaces the new tab page with a live grid of your Bookmarks Toolbar.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@georg-davidson-firefox",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "permissions": ["bookmarks"]
}
